# PostgreSQL connection string. Use your cloud provider's URL when deploying.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/speech_to_text

# Create a key at https://aistudio.google.com/apikey. Keep this on the server only.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional; server defaults to 4000.
PORT=4000
NODE_ENV=development
